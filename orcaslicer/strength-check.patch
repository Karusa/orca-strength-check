+{
+    ar(m_paint, m_direction.x(), m_direction.y(), m_direction.z(), m_magnitude, m_unit, m_load_mode, m_target_fos);
+}
+
+void GLGizmoStrength::on_load(cereal::BinaryInputArchive &ar)
+{
+    ar(m_paint, m_direction.x(), m_direction.y(), m_direction.z(), m_magnitude, m_unit, m_load_mode, m_target_fos);
+    invalidate_result();
